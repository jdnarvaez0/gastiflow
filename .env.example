# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gastiflow
# Para desarrollo local, usa: postgresql://postgres:postgres@localhost:5432/gastiflow
# Para Supabase/Neon, usa la connection string que te proporcionan

# Alternative: Individual PostgreSQL variables (opcional, solo si usas docker-compose)
POSTGRES_DB=gastiflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_from_url
# Para producción (EC2/Railway): usar Base64 del credentials.json
# GOOGLE_CREDENTIALS_B64=base64_encoded_credentials_json

# Configuration (opcional)
TIMEZONE=America/Buenos_Aires
DEFAULT_CURRENCY=ARS
LOG_LEVEL=INFO