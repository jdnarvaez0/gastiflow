# ============================================
# TELEGRAM BOT
# ============================================
# IMPORTANTE: DEV y PROD deben usar TOKENS DIFERENTES
# - Telegram solo permite UNA conexión activa por token
# - Si el bot de PRD está corriendo (ej: EC2), el bot de DEV necesita su propio token
# 
# Para crear un bot de desarrollo:
# 1. Habla con @BotFather en Telegram
# 2. /newbot -> Nombre: "Gastiflow DEV" -> Username: "gastiflow_dev_bot"
# 3. Copia el nuevo token aquí
#
# DESARROLLO (local):
TELEGRAM_BOT_TOKEN=your_dev_bot_token_from_botfather
#
# PRODUCCIÓN (EC2/servidor):
# TELEGRAM_BOT_TOKEN=your_prod_bot_token_from_botfather

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gastiflow
# Para desarrollo local, usa: postgresql://postgres:postgres@localhost:5432/gastiflow
# Para Supabase/Neon, usa la connection string que te proporcionan

# Alternative: Individual PostgreSQL variables (opcional, solo si usas docker-compose)
POSTGRES_DB=gastiflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_from_url
# Para producción (EC2/Railway): usar Base64 del credentials.json
# GOOGLE_CREDENTIALS_B64=base64_encoded_credentials_json

# Configuration (opcional)
TIMEZONE=America/Buenos_Aires
DEFAULT_CURRENCY=ARS
LOG_LEVEL=INFO

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_key_change_in_production

# Email Configuration (for verification emails)
# Para Gmail: usa tu email y una "App Password" (no tu contraseña normal)
# 1. Ve a https://myaccount.google.com/security
# 2. Activa verificación en 2 pasos
# 3. Busca "App passwords" y genera una para "Mail"
# 4. Usa esa contraseña aquí
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@gastiflow.com
SMTP_FROM_NAME=Gastiflow
FRONTEND_URL=http://localhost:3000
