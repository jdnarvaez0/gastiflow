# ============================================================================
#                    GASTIFLOW - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Variables marked with [REQUIRED] must be set for the app to work
# Variables marked with [OPTIONAL] have sensible defaults
# ============================================================================

# ==================== CORE SETTINGS ====================

# [REQUIRED] JWT Secret Key for authentication tokens
# Generate with: openssl rand -hex 32 (or use any random 64-char string)
JWT_SECRET_KEY=your-secret-key-here-change-this

# [REQUIRED] Environment mode
# Values: development | production
# - development: Allows ngrok, disables HTTPS redirect, more verbose logs
# - production: Enables HTTPS redirect, security headers, minimal logs
ENVIRONMENT=development

# ==================== DATABASE ====================

# [REQUIRED] PostgreSQL Connection - Use ONE of these options:

# Option 1: Full connection URL (recommended for production)
DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Individual parameters (if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_DB=gastiflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== TELEGRAM BOT ====================

# [REQUIRED] Telegram Bot Token from @BotFather
# Create a bot: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==================== AI SERVICES ====================

# [OPTIONAL] Google Gemini API Key for AI-powered expense parsing
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ==================== FRONTEND / CORS ====================

# [REQUIRED] Dashboard URL (the app where users log in)
# For local development: http://localhost:3000
# For production: https://app.gastiflow.com or https://your-domain.com
FRONTEND_URL=http://localhost:3000

# [REQUIRED] Landing Page URL (marketing site)
# For local development: http://localhost:3001
# For production: https://gastiflow.com or https://www.your-domain.com
LANDING_URL=http://localhost:3001

# [OPTIONAL] Additional allowed hosts for production
# Comma-separated list of domains (used with TrustedHostMiddleware)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,app.yourdomain.com

# [OPTIONAL] Ngrok URL (only for development when using ngrok)
NGROK_URL=https://your-subdomain.ngrok-free.app

# ==================== EMAIL VERIFICATION ====================

# [OPTIONAL] SMTP Settings for sending verification emails
# If not configured, email verification will be disabled

# For Gmail:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Generate an App Password: https://myaccount.google.com/apppasswords
# 4. Use that password here (NOT your regular Gmail password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=noreply@gastiflow.com
SMTP_FROM_NAME=Gastiflow

# ==================== GOOGLE SHEETS (OPTIONAL) ====================

# For syncing expenses with Google Sheets
# Setup: https://docs.gspread.org/en/latest/oauth2.html

GOOGLE_SHEETS_CREDENTIALS_FILE=config/credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id

# ==================== APPLICATION DEFAULTS ====================

# [OPTIONAL] Default timezone for new users
# Values: Any valid timezone string (e.g., America/New_York, Europe/London)
TIMEZONE=America/Bogota

# [OPTIONAL] Default currency for new users
# Values: Any 3-letter currency code (USD, EUR, COP, ARS, etc.)
DEFAULT_CURRENCY=ARS

# [OPTIONAL] Logging level
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==================== MONITORING (OPTIONAL) ====================

# Sentry DSN for error tracking in production
# Get yours: https://sentry.io -> Create Project -> Get DSN
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
