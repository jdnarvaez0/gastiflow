# ==================== REQUIRED ENVIRONMENT VARIABLES ====================

# JWT Secret Key (REQUIRED - Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-change-this

# Environment (development or production)
ENVIRONMENT=development

# ==================== DATABASE CONFIGURATION ====================

# PostgreSQL Connection (Option 1: Full URL)
DATABASE_URL=postgresql://user:password@host:port/database

# PostgreSQL Connection (Option 2: Individual parameters)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gastiflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== FRONTEND CONFIGURATION ====================

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Allowed hosts for production (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ==================== EMAIL CONFIGURATION ====================

# SMTP Settings for email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@gastiflow.com
SMTP_FROM_NAME=Gastiflow

# ==================== TELEGRAM BOT ====================

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ==================== GOOGLE SERVICES ====================

# Google Sheets API (if using)
GOOGLE_SHEETS_CREDENTIALS_PATH=path/to/credentials.json
GOOGLE_SHEET_ID=your-sheet-id

# Gemini API Key (optional - for system-wide AI features)
GEMINI_API_KEY=your-gemini-api-key

# ==================== MONITORING (OPTIONAL) ====================

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================== NGROK (DEVELOPMENT ONLY) ====================

# Ngrok URL (only for development with ngrok)
NGROK_URL=https://your-subdomain.ngrok-free.app
